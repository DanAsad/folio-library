# Copy to .env (or .env.local) and fill in what you need. Every variable is optional
# for local development: the app runs with an embedded database and demo logins.

# --- Database -------------------------------------------------------------------
# Leave empty to use the embedded PGlite database in ./.data (zero setup).
# For deployment use any Postgres URL, e.g. a free Neon database:
# DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=

# --- Auth -----------------------------------------------------------------------
# Required in production. Generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Sign-in is limited to the pre-made demo accounts (admin / librarian / member).
# Set to "false" to turn off demo resets.
DEMO_MODE=true

# --- Daily job (reminders, expired reservations, demo reset) --------------------
# Vercel Cron calls /api/cron/daily at 04:00 UTC (see vercel.json) and sends this secret.
# Any long random string, e.g.  openssl rand -base64 32
CRON_SECRET=
# Set to "false" to keep the daily job from resetting the demo data.
DEMO_RESET=true

# --- Email (optional) ------------------------------------------------------------
# Notifications always appear in the app. Set both to also email them (https://resend.com).
# RESEND_API_KEY=
# EMAIL_FROM="Folio Library <library@yourdomain.com>"

# --- Online payments (optional) -------------------------------------------------
# Members can pay fines with Stripe Checkout. Only TEST keys are accepted (sk_test_…), so no
# real money moves; pay with card 4242 4242 4242 4242, any future date, any CVC.
# STRIPE_SECRET_KEY=sk_test_...
# Optional webhook (checkout.session.completed -> /api/payments/webhook) for members who
# close the tab before returning to the site:
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- AI -------------------------------------------------------------------------
# AI works out of the box: free, no account and no API key. By default it uses
# Pollinations' anonymous tier (open model GPT-OSS 20B), which allows about one reply
# every 45 seconds per server.
# Set to "false" to turn all AI features off (the app falls back to keyword search etc.).
AI_ENABLED=true
# Optional: point at any other OpenAI-compatible chat endpoint that needs no key,
# e.g. a free local Ollama (https://ollama.com):
# AI_CHAT_URL=http://localhost:11434/v1/chat/completions
# AI_MODEL=llama3.2
