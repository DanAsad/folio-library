# Copy to .env (or .env.local) and fill in what you need. Every variable is optional
# for local development: the app runs with an embedded database and demo logins.

# --- Database -------------------------------------------------------------------
# Leave empty to use the embedded PGlite database in ./.data (zero setup).
# For deployment use any Postgres URL, e.g. a free Neon database:
# DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=

# --- Auth -----------------------------------------------------------------------
# Required in production. Generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# SSO providers: each one appears on the login page once its keys are set.
# Google:  https://console.cloud.google.com/apis/credentials  (OAuth client ID, "Web application")
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google  (and your production URL)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub:  https://github.com/settings/developers  (New OAuth App)
#   Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated emails that become admins when they sign in with SSO.
ADMIN_EMAILS=

# One-click demo accounts (admin / librarian / member). Set to "false" to hide them.
DEMO_MODE=true

# --- AI -------------------------------------------------------------------------
# AI works out of the box: free, no account and no API key. By default it uses
# Pollinations' anonymous tier (open model GPT-OSS 20B), which allows about one reply
# every 45 seconds per server.
# Set to "false" to turn all AI features off (the app falls back to keyword search etc.).
AI_ENABLED=true
# Optional: point at any other OpenAI-compatible chat endpoint that needs no key,
# e.g. a free local Ollama (https://ollama.com):
# AI_CHAT_URL=http://localhost:11434/v1/chat/completions
# AI_MODEL=llama3.2
